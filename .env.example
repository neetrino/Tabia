# Application
NODE_ENV="development"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Database Configuration
DATABASE_URL=""
DATABASE_CONNECTION_LIMIT="10"
DATABASE_POOL_TIMEOUT="20"

# Admin seed (local only)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ——— Cache + rate limit (Upstash Redis) ———
# Used for published list caches and login/contact rate limits.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ——— Email (Resend) ———
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="test@neetrino.com"
CONTACT_TO_EMAIL="client@example.com"

# ——— File storage (Cloudflare R2) ———
# ACCOUNT_ID is the *.r2.cloudflarestorage.com subdomain.
# PUBLIC_URL is the r2.dev or custom domain, without a trailing slash.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# ——— Public social links (optional) ———
NEXT_PUBLIC_SOCIAL_LINKEDIN=""
NEXT_PUBLIC_SOCIAL_FACEBOOK=""
NEXT_PUBLIC_SOCIAL_INSTAGRAM=""
NEXT_PUBLIC_SOCIAL_TELEGRAM=""
